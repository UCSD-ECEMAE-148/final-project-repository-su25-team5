<package format="3">
    <name>ros_control_pkg</name>
    <version>0.0.0</version>
    <description>The ros_control_pkg package</description>
    <maintainer email="zhj014@ucsd.edu">Zhenyu Jiang</maintainer>
    <dependency>rclpy</dependency>
<launch>
    <node pkg="ros_control_pkg" exec="donkey_bridge_node" name="donkey_bridge" output="screen"/>
    <node pkg="ros_control_pkg" exec="Safety_override_node" name="safety_override" output="screen"/>
